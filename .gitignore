# Researcher-only reference material and original repository snapshots.
/private/

# Downloaded upstream benchmark data; obtain from the upstream project separately.
/data/repopairbench/

# Generated experimental workspaces, raw attempts and normalized log copies.
# Ignoring these preserves local files; it does not delete or anonymize them.
/pilot/conditions/
/logs/

# Draft results and human scoring exports. Keep results/manifests/ versioned.
/results/*.csv
/results/*.tsv
/results/*.xlsx

# Local credentials and environment overrides; sanitized examples may be tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
auth.json

